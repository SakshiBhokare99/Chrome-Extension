{
  "manifest_version": 3,
  "name": "Time Tracker & Productivity Analytics",
  "version": "1.0",
  "description": "Track time spent on websites and analyze productivity.",

  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost:3000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"

  },

  "icons": {
    "128": "icon.png"
  }
}